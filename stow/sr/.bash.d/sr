# shellcheck shell=bash
# Ensure pixi bin is on PATH (may not be set in non-login shells)
[[ -d "$HOME/.pixi/bin" && ":$PATH:" != *":$HOME/.pixi/bin:"* ]] && export PATH="$HOME/.pixi/bin:$PATH"

# sr bash completion: auto-install the symlink on first use of a new machine.
# `sr completion install bash` symlinks into ~/.local/share/bash-completion/
# completions/sr, which bash-completion >= 2.10 auto-discovers.
if command -v sr >/dev/null 2>&1 \
	&& [[ ! -e "$HOME/.local/share/bash-completion/completions/sr" ]]; then
	sr completion install bash >/dev/null 2>&1
fi

# sr dotfiles
[[ -f ~/dots/setup.bash ]] && source ~/dots/setup.bash

# alias for sr
SR_INSTALLATION_TOOLS_DIR="$HOME/src/sr_installation_tools"
alias sr-update="( cd ${SR_DOTS_DIR:-$HOME/dots} && git pull );pixi global install --force-reinstall caty sr_installation_tools -c https://conda.smart-robotics.nl/get/smart-robotics -c conda-forge"

# sr_deployment
[[ -f "$HOME/src/sr_deployment/scripts/common.bash" ]] && source "$HOME/src/sr_deployment/scripts/common.bash"

# aliases for sr ides
alias sr-clion='tmux new -d sr run clion \$CONDA_DEFAULT_ENV'
alias sr-code='tmux new -d sr run code \$CONDA_DEFAULT_ENV'
alias sr-pycharm='tmux new -d sr run pycharm \$CONDA_DEFAULT_ENV'

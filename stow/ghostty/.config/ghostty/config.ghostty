# ── Colors ─────────────────────────────────────────────────────────────
theme = gruvbox-material-dark

# ── Font ───────────────────────────────────────────────────────────────
font-family = FiraCode Nerd Font Mono
font-size = 11
font-feature = -calt
font-feature = -clig
font-feature = -liga
adjust-underline-position = 25%

# ── Cursor ─────────────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = false
mouse-hide-while-typing = true

# ── Window ────────────────────────────────────────────────────────────
resize-overlay = never

# ── Tab bar / titlebar ─────────────────────────────────────────────────
gtk-titlebar-style = tabs
gtk-wide-tabs = true

# ── Keybinds ───────────────────────────────────────────────────────────
keybind = ctrl+shift+r=prompt_tab_title
keybind = f11=toggle_fullscreen

# ── Tabs ───────────────────────────────────────────────────────────────
keybind = ctrl+shift+home=previous_tab
keybind = ctrl+shift+end=next_tab
# Adding alt moves the tab instead of going to it.
keybind = ctrl+alt+shift+home=move_tab:-1
keybind = ctrl+alt+shift+end=move_tab:1

# ── Splits ─────────────────────────────────────────────────────────────
# Rebind these to prevent conflict with COSMIC
keybind = super+ctrl+shift+arrow_left=unbind
keybind = super+ctrl+shift+arrow_right=unbind
keybind = super+ctrl+shift+arrow_up=unbind
keybind = super+ctrl+shift+arrow_down=unbind

# Pane focus on ctrl+shift+arrows, which default to previous_tab/next_tab.
# Tabs are on ctrl+tab / ctrl+shift+tab, so those defaults are free to reuse.
keybind = ctrl+shift+arrow_left=goto_split:left
keybind = ctrl+shift+arrow_right=goto_split:right
keybind = ctrl+shift+arrow_up=goto_split:up
keybind = ctrl+shift+arrow_down=goto_split:down

keybind = ctrl+alt+shift+arrow_left=resize_split:left,9
keybind = ctrl+alt+shift+arrow_right=resize_split:right,9
keybind = ctrl+alt+shift+arrow_up=resize_split:up,18
keybind = ctrl+alt+shift+arrow_down=resize_split:down,18

# Screen dumps moved from j to d (dumps)
keybind = ctrl+shift+j=unbind
keybind = ctrl+alt+shift+j=unbind
keybind = super+ctrl+shift+j=unbind
keybind = ctrl+shift+d=write_screen_file:paste,plain
keybind = ctrl+alt+shift+d=write_screen_file:open,plain
keybind = super+ctrl+shift+d=write_screen_file:copy,plain

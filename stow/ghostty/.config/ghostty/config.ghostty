# ── Colors ─────────────────────────────────────────────────────────────
theme = gruvbox-material-dark

# ── Font ───────────────────────────────────────────────────────────────
font-family = FiraCode Nerd Font Mono
font-size = 11
font-feature = -calt
font-feature = -clig
font-feature = -liga

# ── Cursor ─────────────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = false
mouse-hide-while-typing = true

# ── Tab bar / titlebar ─────────────────────────────────────────────────
gtk-titlebar-style = tabs
gtk-wide-tabs = true

# ── Keybinds ───────────────────────────────────────────────────────────
keybind = ctrl+shift+r=prompt_tab_title
keybind = f11=toggle_fullscreen

# ── Splits ─────────────────────────────────────────────────────────────
# Ghostty's split layer cannot take part in smart-splits' @pane-is-vim
# handshake, so any chord it binds is taken from nvim/tmux unconditionally.
# The whole hjkl tier is therefore left untouched and passes straight
# through: alt+hjkl moves and ctrl+alt+hjkl resizes, seamlessly across nvim
# windows and tmux panes.
#
# Ghostty's splits live on arrows instead, which collide with neither.
# Movement keeps the stock ctrl+alt+<arrow>. Resize has to be rebound: the
# stock chord is super+ctrl+shift+<arrow>, which COSMIC grabs for
# MoveTo{Previous,Next}Workspace, so ghostty is never delivered it. Move it
# to ctrl+alt+shift+<arrow>, free in both COSMIC and nvim/tmux, and retire
# the unreachable defaults so +list-keybinds stays honest.
#
# The amounts are one cell, to match the 1-cell step used by tmux
# (resize-pane) and nvim (smart-splits default_amount). Unlike those two,
# resize_split takes PIXELS, not cells, so the cell size is derived from
# FiraCode Nerd Font Mono at font-size 11:
#   unitsPerEm 1950, advance 1200 (0.6154 em), line height 2400 (1.2308 em)
#   11pt @ 96dpi = 14.67px/em  ->  cell = 9.03 x 18.05 px
# Recompute these if font-family or font-size changes.
keybind = super+ctrl+shift+arrow_left=unbind
keybind = super+ctrl+shift+arrow_right=unbind
keybind = super+ctrl+shift+arrow_up=unbind
keybind = super+ctrl+shift+arrow_down=unbind
keybind = ctrl+alt+shift+arrow_left=resize_split:left,9
keybind = ctrl+alt+shift+arrow_right=resize_split:right,9
keybind = ctrl+alt+shift+arrow_up=resize_split:up,18
keybind = ctrl+alt+shift+arrow_down=resize_split:down,18

# Screen/scrollback dumps. Ghostty's defaults put three variants of
# write_screen_file on `j` (paste/open/copy the temp file's PATH), one of
# which COSMIC ate anyway. Retire all three and use `d` for "dump": the
# useful action (open in $EDITOR) on the primary chord, and the full
# scrollback rather than just the visible screen on the second.
# `d` is free in ghostty and unused by COSMIC in every modifier tier.
keybind = ctrl+shift+j=unbind
keybind = super+ctrl+shift+j=unbind
keybind = ctrl+shift+d=write_screen_file:open,plain
keybind = alt+ctrl+shift+d=write_scrollback_file:open,plain

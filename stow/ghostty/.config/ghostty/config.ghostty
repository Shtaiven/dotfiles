# ── Colors ─────────────────────────────────────────────────────────────
theme = gruvbox-material-dark

# ── Font ───────────────────────────────────────────────────────────────
font-family = FiraCode Nerd Font Mono
font-size = 11
font-feature = -calt
font-feature = -clig
font-feature = -liga
adjust-underline-position = 25%

# ── Cursor ─────────────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = false
cursor-click-to-move = true
mouse-hide-while-typing = true

# ── Shell integration ──────────────────────────────────────────────────
# Omitted features keep their defaults (cursor, path on; sudo off).
# no-title: Ghostty's own title hook wins the last-writer race in both shells
#   (zsh precmd re-appends itself to the end of precmd_functions; bash appends
#   the OSC to PS1, printed after PROMPT_COMMAND), and its two implementations
#   disagree -- zsh sends `…/%3~`, bash sends the full `\w`. Off, so the rc
#   files own the title and both shells show the same format.
# ssh-env: send COLORTERM + TERM_PROGRAM* to the remote (needs AcceptEnv in its
#   sshd_config) and use TERM=xterm-256color so it isn't an unknown terminal.
# ssh-terminfo: install xterm-ghostty into the remote's ~/.terminfo instead
#   (infocmp locally, tic remotely) and keep TERM=xterm-ghostty when it works,
#   falling back to ssh-env's xterm-256color when it doesn't.
# Installed hosts are cached; manage with `ghostty +ssh-cache`.
shell-integration-features = no-title,ssh-env,ssh-terminfo

# ── Window ────────────────────────────────────────────────────────────
resize-overlay = never
# y is 1pt under x: with balance off the ink fills the cell edge-to-edge
# horizontally but stops ~1.9px short of the ascender, so equal padding
# reads as a wider top gap. Integers only.
window-padding-x = 4
window-padding-y = 3
window-padding-balance = false

# ── Tab bar / titlebar ─────────────────────────────────────────────────
gtk-titlebar-style = tabs
gtk-wide-tabs = false
gtk-toolbar-style = flat

# ── Bell ───────────────────────────────────────────────────────────────
# Adds to the defaults (attention, title). COSMIC largely ignores the GTK
# urgency hint that `attention` sets, so draw a border on the alerted surface.
bell-features = border
# The border color is not a config option; it comes from Ghostty's built-in GTK
# stylesheet (libadwaita --accent-color). Override it with gruvbox yellow.
gtk-custom-css = gtk.css

# ── Keybinds ───────────────────────────────────────────────────────────
keybind = ctrl+shift+r=prompt_tab_title
keybind = f11=toggle_fullscreen
keybind = ctrl+shift+z=toggle_split_zoom

# ── Tabs ───────────────────────────────────────────────────────────────
keybind = ctrl+shift+home=previous_tab
keybind = ctrl+shift+end=next_tab
# Adding alt moves the tab instead of going to it.
keybind = ctrl+alt+shift+home=move_tab:-1
keybind = ctrl+alt+shift+end=move_tab:1

# ── Splits ─────────────────────────────────────────────────────────────
# Move the zoom to the newly focused split instead of unzooming (pairs with
# toggle_split_zoom + goto_split below).
split-preserve-zoom = navigation

# Default 0.7 dims unfocused splits heavily against gruvbox dark.
unfocused-split-opacity = 0.8

# Rebind these to prevent conflict with COSMIC
keybind = super+ctrl+shift+arrow_left=unbind
keybind = super+ctrl+shift+arrow_right=unbind
keybind = super+ctrl+shift+arrow_up=unbind
keybind = super+ctrl+shift+arrow_down=unbind

# Pane focus on ctrl+shift+arrows, which default to previous_tab/next_tab.
# Tabs are on ctrl+tab / ctrl+shift+tab, so those defaults are free to reuse.
keybind = ctrl+shift+arrow_left=goto_split:left
keybind = ctrl+shift+arrow_right=goto_split:right
keybind = ctrl+shift+arrow_up=goto_split:up
keybind = ctrl+shift+arrow_down=goto_split:down

keybind = ctrl+alt+shift+arrow_left=resize_split:left,9
keybind = ctrl+alt+shift+arrow_right=resize_split:right,9
keybind = ctrl+alt+shift+arrow_up=resize_split:up,18
keybind = ctrl+alt+shift+arrow_down=resize_split:down,18
keybind = ctrl+alt+shift+equal=equalize_splits

# ── Screen Dumps ───────────────────────────────────────────────────────
keybind = ctrl+shift+j=unbind
keybind = ctrl+alt+shift+j=unbind
keybind = super+ctrl+shift+j=unbind
keybind = ctrl+shift+d=write_screen_file:paste,plain
keybind = ctrl+alt+shift+d=write_screen_file:open,plain
keybind = super+ctrl+shift+d=write_screen_file:copy,plain

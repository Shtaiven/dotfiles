# Gruvbox Material Dark
# Ported from ~/.config/wezterm/colors/Gruvbox Material Dark.toml
# origin: https://github.com/sainnhe/gruvbox-material

background = #101010
foreground = #d4be98

cursor-color = #d4be98
cursor-text = #101010

# wezterm selection_fg = 'none' -> keep each cell's own foreground
selection-background = #45403d
selection-foreground = cell-foreground

split-divider-color = #504945

# wezterm `ansi` and `brights` are identical in this theme, so 8-15 repeat 0-7.
palette = 0=#5a524c
palette = 1=#ea6962
palette = 2=#a9b665
palette = 3=#d8a657
palette = 4=#7daea3
palette = 5=#d3869b
palette = 6=#89b482
palette = 7=#d4be98
palette = 8=#5a524c
palette = 9=#ea6962
palette = 10=#a9b665
palette = 11=#d8a657
palette = 12=#7daea3
palette = 13=#d3869b
palette = 14=#89b482
palette = 15=#d4be98

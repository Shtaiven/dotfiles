[user]
    name = Steven Eisinger
    email = steven.a.eisinger@gmail.com

[core]
    pager = delta

[branch]
    sort = -committerdate

[tag]
    sort = version:refname

[init]
    defaultBranch = main

[advice]
    detachedHead = false

[push]
    default = simple
    autoSetupRemote = true
    followTags = true
    useForceIfIncludes = true

[fetch]
    prune = true
    pruneTags = true
    all = true

[interactive]
    diffFilter = delta --color-only

[delta]
    syntax-theme = base16   # color theme
    line-numbers = true
    navigate = true         # use n and N to move between diff sections
    dark = true
    map-styles = bold purple => syntax darkmagenta, bold cyan => syntax darkblue  # for diff.colorMoved

[merge]
    conflictstyle = diff3

[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true
    renames = true

[help]
    autocorrect = prompt

[commit]
    verbose = true

[rerere]
    enabled = true
    autoupdate = true

[rebase]
    autoSquash = true
    autoStash = true
    updateRefs = true

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

[alias]
    p = pull
    u = push
    c = commit
    a = add
    d = diff
    s = status
    r = rebase
    m = merge
    b = branch
    t = tag
    f = fetch
    l = log
    ll = dirs
    ls = dirs
    ch = checkout
    pushf = push --force-with-lease
    uf = pushf
    act = activity

    # Show activity on the changes to the repository
    activity = for-each-ref --sort=committerdate --exclude='refs/remotes/*/HEAD' refs/remotes/ --format='%(color:red)%(refname:short)%(color:reset) - %(color:yellow)%(objectname:short)%(color:reset) - %(contents:subject) - %(authorname) (%(color:green)%(committerdate:relative)%(color:reset))'

    # A pretty log format
    tree = log --all --decorate --oneline --graph

    # Checkout the latest tag
    latest =!git fetch --tags && git checkout $(git describe --tags $(git rev-list --tags --max-count=1))

    # Get the short hash of the current commit
    hash = rev-parse --short HEAD

    # `git dirs` (and `ls`/`ll` above) runs scripts/git-dirs, symlinked to
    # ~/.local/bin by the shell package's install

    # Delete merged branches
    delete-merged = "!f() { git branch --merged ${1:-main} | grep -v '\\*\\|master\\|main' | xargs -n 1 git branch -d; }; f"

[pager]
    diff = delta
    show = delta
    log = delta
    blame = delta
    reflog = delta
    grep = delta

# Authenticate GitHub HTTPS fetches via the gh CLI.
# Anonymous HTTPS git requests are rate-limited per-IP: lazy.nvim fires one
# fetch per plugin concurrently and GitHub answers most with 401, which git
# turns into "could not read Username for 'https://github.com'".
[credential "https://github.com"]
    helper = !gh auth git-credential

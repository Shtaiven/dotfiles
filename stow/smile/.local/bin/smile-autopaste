#!/bin/bash
# Deliver the emoji Smile just copied into the focused window.
#
# Smile cannot synthesise input on Wayland: Picker.py only calls xdotool in an
# `XDG_SESSION_TYPE != wayland` branch, so on Wayland it emits
# CopiedEmojiBroadcast and stops. The signal carries the emoji as its argument.
#
# wtype types the emoji itself: no clipboard dependency, and it works with a
# terminal focused (ctrl+v is not paste there, ctrl+shift+v is). wtype uploads a
# generated keymap over zwp_virtual_keyboard_v1, which cosmic-comp implements.
# This is COSMIC/KDE/wlroots only -- Mutter does not implement that protocol.
#
# dotool is deliberately not used: it maps characters onto keys of the active XKB
# layout and emoji are in no layout ("impossible character for layout"), so it can
# only replay ctrl+v, which needs the clipboard and does nothing in a terminal.
#
# Delivery has to wait: Smile emits this from
# default_hiding_action() in the same breath as set_visible(False), so the
# compositor has not handed keyboard focus back to your window yet. Input
# synthesised immediately goes to a surface that is going away. This is routing,
# not mechanism -- wtype needs the wait exactly as much as ctrl+v did.

set -u

SETTLE=0.1 # seconds to wait for focus to return to the target window

if ! command -v wtype >/dev/null 2>&1; then
  echo "Error: wtype is not installed or not in PATH" >&2
  exit 1
fi

dbus-monitor --session "type='signal',interface='it.mijorus.smile',member='CopiedEmojiBroadcast',path='/it/mijorus/smile/actions'" |
  while read -r line; do
    case "$line" in
      *member=CopiedEmojiBroadcast*) ;;
      *) continue ;;
    esac

    # The argument is on the next line, as:    string "<emoji>"
    IFS= read -r arg || break
    case "$arg" in
      *string\ \"*\") ;;
      *)
        echo "unexpected signal payload: $arg" >&2
        continue
        ;;
    esac

    emoji=${arg#*\"}
    emoji=${emoji%\"*}
    [ -n "$emoji" ] || continue

    sleep "$SETTLE"
    wtype -- "$emoji"
  done
